PARALOG_PASSWORD=choose-a-long-password
PARALOG_AUTH_SECRET=replace-with-a-long-random-secret
# Sign in with Pocket ID (or another OpenID Connect provider). PARALOG_PASSWORD becomes optional.
# PARALOG_OIDC_ISSUER=https://id.example.com
# PARALOG_OIDC_CLIENT_ID=replace-with-the-client-id
# PARALOG_OIDC_CLIENT_SECRET=replace-with-the-client-secret
# PARALOG_OIDC_SUBJECT=your-pocket-id-user-id
# PARALOG_PUBLIC_URL=https://journal.example.com
# PARALOG_OIDC_NAME=Pocket ID
# PARALOG_ALLOWED_DEV_ORIGINS=paralog.example.test
PARALOG_VAPID_SUBJECT=mailto:you@example.com
PARALOG_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
PARALOG_GEOCODING_USER_AGENT=Paralog/0.1 (+https://github.com/itsamenathan/paralog)
IMMICH_API_URL=https://photos.example.com
IMMICH_API_KEY=replace-with-an-immich-api-key
PARALOG_GITHUB_TOKEN=replace-with-a-read-only-github-token
# OpenTelemetry trace export; unset means nothing is sent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://clickstack-collector.example:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=replace-with-the-clickstack-ingestion-key
# OTEL_SERVICE_NAME=paralog
# PARALOG_LOG_LEVEL=info
# OTEL_LOGS_EXPORTER=otlp  # also export logs through the SDK; stdout is the default log path
